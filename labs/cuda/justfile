# cuda — host setup for a CUDA box. `just` lists recipes.
set shell := ["bash", "-euo", "pipefail", "-c"]
here := justfile_directory()

default:
    @just --list

# Enter the shell: setup-cuda-cache and setup-ml-venv on PATH.
shell:
    nix develop "{{here}}"

# Run both tools' tests (`cargo test` in tools/, the dev shell's cargo; CI builds them as flake checks).
self-test:
    nix develop "{{here}}" --command cargo test --manifest-path "{{here}}/tools/Cargo.toml"

# Show the nix.custom.conf block the cache setup would write; `sudo just cache-setup apply` writes it.
cache-setup mode="--dry-run":
    nix run "{{here}}#setup-cuda-cache" -- {{ if mode == "apply" { "" } else { mode } }}

# Which Nix config still names the dead cuda-maintainers.cachix.org (the 401 warning), and the fix for each.
doctor:
    nix run "{{here}}#setup-cuda-cache" -- --doctor

# Build a CUDA torch venv for <requirements-file> at VENV_ROOT (default ~/.ml-venv).
[no-cd]
venv requirements:
    REQUIREMENTS="{{requirements}}" nix run "{{here}}#setup-ml-venv"
