# prático — the WW3 (WAVEWATCH III) Fortran/C++/MPI/NetCDF toolchain for ww-lab, a local zsh
# pilot (zsh-ai → llm → Ollama), and ai-jail for sandboxed agents.
# Every path is anchored on justfile_directory() so this works unchanged when nix-config is
# a submodule of ww-lab:   just -f <ww-lab>/nix-config/labs/pratico/justfile <recipe>

set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-load

here  := justfile_directory()
model := env_var_or_default("LLM_MODEL", "qwen2.5-coder:7b")

default:
    @just --list

# Enter the interactive shell: WW3 toolchain + zsh-ai → llm → Ollama + ai-jail (re-execs into zsh).
dev:
    nix develop "{{here}}"

# ---------------------------------------------------------------------
# WW3 toolchain — gfortran, OpenMPI, NetCDF-C/Fortran, HDF5, METIS/ParMETIS,
# ecCodes, nco/cdo, python (numpy/scipy/xarray/netCDF4/matplotlib), all from
# the one nixpkgs pinned in flake.lock. `.#ww3` is the toolchain with no zsh
# re-exec and no AI tooling: the shell ww-lab's build scripts and CI call.
# ---------------------------------------------------------------------

# Toolchain-only shell (no zsh re-exec, no AI tools) — what ww-lab builds WW3 in.
ww3:
    nix develop "{{here}}#ww3"

#   just ww3-run cmake -S model -B build -DSWITCH=Ifremer1 -DCMAKE_INSTALL_PREFIX=install
#   just ww3-run mpirun -np 4 ww3_shel
#
# Run a command inside the toolchain shell without entering it.
ww3-run *cmd:
    nix develop "{{here}}#ww3" --command {{cmd}}

# Print the exact compiler/library versions the shell provides (paste into a paper's methods).
toolchain:
    #!/usr/bin/env bash
    set -euo pipefail
    nix develop "{{here}}#ww3" --command bash -c '
        echo "nixpkgs      $(nix flake metadata --json "{{here}}" | jq -r .locks.nodes.nixpkgs.locked.rev)"
        echo "gfortran     $(gfortran --version | head -1)"
        echo "openmpi      $(mpirun --version | head -1)"
        echo "netcdf-c     $(nc-config --version)"
        echo "netcdf-f     $(nf-config --version)"
        echo "hdf5         $(h5dump --version | head -1)"
        echo "metis        $METIS_PATH"
        echo "parmetis     $PARMETIS_PATH"
        echo "pt-scotch    $SCOTCH_PATH"
        echo "eccodes      $(codes_info -v)"
        echo "cmake        $(cmake --version | head -1)"
        probe="$(mktemp -d)"
        cmake -S "{{here}}/smoke/kokkos" -B "$probe" >"$probe/cmake.log" 2>&1 || cat "$probe/cmake.log" >&2
        sed -n "s/^-- kokkos /kokkos       /p" "$probe/cmake.log"
        rm -rf "$probe"
        echo "gdb          $(gdb --version | head -1)"
        echo "valgrind     $(valgrind --version)"
        echo "python       $(python3 --version) numpy $(python3 -c "import numpy;print(numpy.__version__)") xarray $(python3 -c "import xarray;print(xarray.__version__)")"
    '

# The same check CI runs. Leaves ./result with hs.nc, hs.cdl and versions.txt.
#
# Build the toolchain smoke test (Fortran 2008 + MPI + NetCDF-4 write, then ncdump) in the Nix sandbox.
smoke:
    nix build "{{here}}#checks.$(nix eval --impure --raw --expr builtins.currentSystem).toolchain" --print-build-logs --out-link "{{here}}/result"

# ---------------------------------------------------------------------
# Kokkos — the C++ performance-portability layer ww3-gpu's kernels are
# written against: Serial + OpenMP in `.#ww3`, plus a CUDA build of the
# same source in `.#cuda` (x86_64-linux). GoogleTest, gdb and valgrind
# ride along in both shells.
# ---------------------------------------------------------------------

# Build the Kokkos + GoogleTest smoke project (configure, ctest, run) in the Nix sandbox.
kokkos-smoke:
    nix build --no-link --print-out-paths "{{here}}#checks.$(nix eval --impure --raw --expr builtins.currentSystem).kokkos-smoke"

# Toolchain shell with Kokkos built for CUDA (Ada 8.9 — the RTX 4090). x86_64-linux only.
cuda:
    nix develop "{{here}}#cuda"

# Make sure an Ollama server is reachable, starting one if not.
ollama-serve:
    #!/usr/bin/env bash
    set -euo pipefail
    api="${OLLAMA_HOST:-http://127.0.0.1:11434}/api/tags"
    if ! curl -sf -m 2 "$api" >/dev/null; then
        mkdir -p "{{here}}/.tmp"
        echo "ollama: not reachable at $api — starting 'ollama serve' in the background"
        nohup ollama serve >"{{here}}/.tmp/ollama.log" 2>&1 &
        for _ in $(seq 1 30); do
            curl -sf -m 1 "$api" >/dev/null && break
            sleep 1
        done
        curl -sf -m 2 "$api" >/dev/null || { echo "ollama: server did not come up — see .tmp/ollama.log" >&2; exit 1; }
    fi

# Pull the model the shell expects (default: the flake's qwen2.5-coder:7b; LLM_MODEL overrides).
pull model=model: ollama-serve
    #!/usr/bin/env bash
    set -euo pipefail
    if ollama list | awk 'NR>1 {print $1}' | grep -qx "{{model}}"; then
        echo "ollama: model '{{model}}' already pulled"
    else
        echo "ollama: pulling '{{model}}'..."
        ollama pull "{{model}}"
    fi

# One-shot question to the local model through llm (run inside `just dev`, where llm is on PATH).
ask *question:
    llm -m "{{model}}" "{{question}}"

# ---------------------------------------------------------------------
# ai-jail — sandbox AI coding agents (bubblewrap/Landlock/seccomp on
# Linux). https://github.com/akitaonrails/ai-jail
# Project policy lives in `.ai-jail` (committed, untrusted layer — can
# only tighten, never grant). Per-machine trust/capabilities go in
# ~/.ai-jail, not here. `--network` is on for these because Claude Code
# needs it (dependency resolution / API calls) — this is containment for
# the filesystem/process blast radius, not a network firewall.
# ---------------------------------------------------------------------

# Use this to audit a command's jail before trusting it for real.
#
# Print the sandbox invocation ai-jail would run, without running it.
jail-dry-run *cmd:
    ai-jail --no-save-config --dry-run -- {{cmd}}

# --no-save-config keeps a jailed run from writing the host's config.

# Run this on the host before `just jco` — never inside a jail, where a login goes to an
# ephemeral HOME. `--refresh` re-runs gh's flow to ADD scopes; `--login` forces a fresh login.
#
# Make sure the HOST has a GitHub credential the jail can borrow, then say which one.
gh-auth *args:
    #!/usr/bin/env bash
    set -euo pipefail
    # The Rust tools (labs/pratico/tools): already on PATH inside `just dev`, built from the flake otherwise.
    command -v gh-token >/dev/null 2>&1 || export PATH="$(nix build --no-link --print-out-paths "{{here}}#tools")/bin:$PATH"
    case "{{args}}" in
        *--refresh*) exec gh auth refresh ;;
        *--login*)   exec gh auth login ;;
    esac
    if src="$(gh-token --source)"; then
        echo "gh-auth: already authenticated — $src"
        if [ "$src" = "gh:host-login" ]; then gh auth status 2>&1 | sed 's/^/  /'; fi
        echo 'gh-auth: "just jco" will forward this token into the jail; no login needed in there.'
    else
        echo "gh-auth: no credential on this host yet — running gh auth login (one time)."
        gh auth login
        gh-token --source >/dev/null && echo "gh-auth: done — now run: just jco"
    fi

#   PRATICO_JAIL_CLIPBOARD=1        write-only clipboard bridge (`just clip` from inside the jail)
#   PRATICO_JAIL_CLIPBOARD_PASTE=1  real display passthrough — the jail can READ your clipboard
#
# Claude Code in the jail.
jail-claude *args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{here}}"
    # The Rust tools (labs/pratico/tools): already on PATH inside `just dev`, built from the flake otherwise.
    command -v gh-token >/dev/null 2>&1 || export PATH="$(nix build --no-link --print-out-paths "{{here}}#tools")/bin:$PATH"
    relay_pid=""
    cleanup() {
        if [ -n "$relay_pid" ]; then
            kill -TERM "$relay_pid" 2>/dev/null || true
            wait "$relay_pid" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT INT TERM
    if [ "${PRATICO_JAIL_CLIPBOARD:-0}" = "1" ]; then
        mkdir -p .tmp
        fifo=".tmp/clip.fifo"
        rm -f "$fifo"
        mkfifo "$fifo"
        clip-relay "$fifo" &
        relay_pid=$!
        sleep 0.2
        if ! kill -0 "$relay_pid" 2>/dev/null; then
            wait "$relay_pid" 2>/dev/null || true
            relay_pid=""
        fi
    fi
    paste_flags=()
    if [ "${PRATICO_JAIL_CLIPBOARD_PASTE:-0}" = "1" ]; then
        echo "jail-claude: PRATICO_JAIL_CLIPBOARD_PASTE=1 — real X11/Wayland display passthrough is on, the jail can read your clipboard (and, on X11, more)" >&2
        paste_flags=(--display --env DISPLAY --env WAYLAND_DISPLAY --env "XDG_RUNTIME_DIR=/run/user/$(id -u)")
    fi
    # Resolve the token out here, on the host, where the real gh login lives: ~/.config/gh is
    # deliberately NOT mapped into the jail, so authenticating inside it writes to an ephemeral
    # HOME and is gone by the next session. See labs/pratico/tools (gh-token).
    if src="$(gh-token --source)"; then
        GH_TOKEN="$(gh-token)"
        export GH_TOKEN
        echo "jail-claude: GH_TOKEN from $src — gh works inside the jail, no login needed" >&2
    else
        echo "jail-claude: no GitHub token (no GH_TOKEN in .env, and gh is logged out on the host)." >&2
        echo "             gh will not work inside the jail." >&2
        echo "             Fix once, on the host: gh auth login   (or add GH_TOKEN= to .env)" >&2
    fi
    ai-jail --no-save-config --rw-map ~/.claude --rw-map ~/.claude.json --map ~/.ssh --network --terminal-passthrough --exec --env GH_TOKEN "${paste_flags[@]}" claude {{args}}

# The three below pin the model via Claude Code's own alias (always the latest of that line), and
# still forward any further args to `claude`.

# jail-claude with --model fable.
jcf *args: (jail-claude "--model" "fable" args)

# jail-claude with --model sonnet.
jcs *args: (jail-claude "--model" "sonnet" args)

# jail-claude with --model opus.
jco *args: (jail-claude "--model" "opus" args)

# OpenCode in the same jail, with its own state directories instead of Claude Code's.
jail-opencode *args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{here}}"
    # The Rust tools (labs/pratico/tools): already on PATH inside `just dev`, built from the flake otherwise.
    command -v gh-token >/dev/null 2>&1 || export PATH="$(nix build --no-link --print-out-paths "{{here}}#tools")/bin:$PATH"
    if src="$(gh-token --source)"; then
        GH_TOKEN="$(gh-token)"
        export GH_TOKEN
        echo "jail-opencode: GH_TOKEN from $src" >&2
    fi
    ai-jail --no-save-config --rw-map ~/.config/opencode --rw-map ~/.local/share/opencode --rw-map ~/.cache/opencode --network --terminal-passthrough --exec --env GH_TOKEN opencode {{args}}

# jail-opencode, short alias.
jo *args: (jail-opencode args)

# Push stdin (or --text "…") to the clipboard — write-only, no paste counterpart.
clip *args:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v clip >/dev/null 2>&1 || export PATH="$(nix build --no-link --print-out-paths "{{here}}#tools")/bin:$PATH"
    PRATICO_ROOT="{{here}}" exec clip {{args}}

# The tools' tests (cargo test), clippy and rustfmt, in the Nix sandbox.
tools-test:
    nix build --no-link --print-build-logs "{{here}}#checks.$(nix eval --impure --raw --expr builtins.currentSystem).tools" "{{here}}#checks.$(nix eval --impure --raw --expr builtins.currentSystem).tools-clippy" "{{here}}#checks.$(nix eval --impure --raw --expr builtins.currentSystem).tools-fmt"
