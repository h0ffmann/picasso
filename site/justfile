# picasso's site. Run inside `nix develop` (from site/).

default:
    @just --list

# Compile, bundle and prerender into dist/
build: releases
    rm -rf dist
    mkdir -p dist
    gleam build
    esbuild entry.mjs --bundle --minify --format=esm --outfile=dist/app.js --log-level=warning
    gleam run -m picasso_site/prerender --no-print-progress > dist/index.html
    cp -R static/. dist/

# Write the release tags and the Zenodo DOIs into src/picasso_site_releases.mjs
releases:
    nix run ../tools#site-releases --

# Unit tests, on node
test: releases
    gleam test

# Formatting, tests, a build and the hard rules: what CI runs
ci:
    gleam format --check src test
    just test
    just build
    nix run ../tools#site-check --

# Build and serve on http://localhost:8000
serve: build
    miniserve --index index.html -p 8000 dist

# Rewrite static/history.json from a full clone (history.nix; Nix cannot run git, so it reads the log)
history:
    #!/usr/bin/env bash
    set -euo pipefail
    log="$(mktemp)"
    trap 'rm -f "$log"' EXIT
    git log --reverse --first-parent main --numstat --format='@@@%H%x09%ad%x09%an%x09%s' --date=short > "$log"
    nix eval --raw --file history.nix json --argstr logFile "$log" > static/history.json
    nix eval --raw --file history.nix summary --argstr logFile "$log"
